# HackOS Environment Configuration
# Duplicate this file to .env or backend/.env and update values for your environment.
# Never commit real credentials to source control.

# Application Environment (development | test | production)
NODE_ENV=development

# Backend Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackos?schema=public

# Session Secret (Minimum 32 characters for security)
SESSION_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars-long
