datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. User & Identity
// -------------------------------------------------------------

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String         @map("password_hash")
  emailVerifiedAt   DateTime?      @map("email_verified_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  disabledAt        DateTime?      @map("disabled_at")

  profile           UserProfile?
  sessions          Session[]
  ownedEvents       Event[]        @relation("EventOwner")
  memberships       EventMember[]
  auditLogs         AuditLog[]

  @@map("users")
}

model UserProfile {
  userId            String         @id @map("user_id")
  displayName       String         @map("display_name")
  collegeName       String?        @map("college_name")
  avatarStorageKey  String?        @map("avatar_storage_key")
  bio               String?

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// -------------------------------------------------------------
// 2. Server-Managed Session Store (ADR-011)
// -------------------------------------------------------------

model Session {
  id                String         @id @default(uuid())
  tokenHash         String         @unique @map("token_hash")
  userId            String         @map("user_id")
  expiresAt         DateTime       @map("expires_at")
  revokedAt         DateTime?      @map("revoked_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// -------------------------------------------------------------
// 3. Event & Event Membership (ADR-012, ADR-013)
// -------------------------------------------------------------

enum EventRole {
  ORGANIZER
  PARTICIPANT
  JUDGE
}

enum EventMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Event {
  id                String         @id @default(uuid())
  ownerId           String         @map("owner_id")
  name              String
  slug              String         @unique // ADR-013
  description       String?
  timezone          String         @default("UTC")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  owner             User           @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members           EventMember[]
  auditLogs         AuditLog[]

  @@map("events")
}

model EventMember {
  id                String            @id @default(uuid())
  eventId           String            @map("event_id")
  userId            String            @map("user_id")
  role              EventRole
  status            EventMemberStatus @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at")

  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  // ADR-012: Exactly one role per user per event
  @@unique([eventId, userId])
  @@index([eventId, role])
  @@index([userId])
  @@map("event_members")
}

// -------------------------------------------------------------
// 4. System Audit Trail (03_DATABASE_DESIGN.md)
// -------------------------------------------------------------

model AuditLog {
  id                String         @id @default(uuid())
  eventId           String?        @map("event_id")
  actorUserId       String?        @map("actor_user_id")
  action            String
  entityType        String         @map("entity_type")
  entityId          String?        @map("entity_id")
  metadata          Json?          @default("{}")
  createdAt         DateTime       @default(now()) @map("created_at")

  event             Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor             User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
